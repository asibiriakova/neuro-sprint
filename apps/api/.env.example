# Supabase JWT verification (see app/auth.py).
#
# Where to find these: Supabase dashboard -> Project Settings -> API ->
# JWT Settings.

# The project's JWT signing secret ("Legacy JWT Secret" / shared HS256
# secret Supabase signs access tokens with by default). Required for
# `GET /me` and any other route behind `get_current_user` to work.
SUPABASE_JWT_SECRET=

# Expected `aud` claim on access tokens. Supabase issues "authenticated"
# for logged-in users by default — only change this if your project
# customizes it.
SUPABASE_JWT_AUD=authenticated

# Note: if your Supabase project uses asymmetric JWT signing keys
# (JWKS-based, e.g. ES256/RS256) instead of the legacy shared secret,
# SUPABASE_JWT_SECRET verification in app/auth.py will not work — that
# setup needs a JWKS-fetching verifier instead. Check Project Settings ->
# API -> JWT Settings for which signing method your project uses.

# --- Unrelated to auth, but see app/db.py --------------------------------
# Postgres connection string for the same Supabase project (Project
# Settings -> Database -> Connection string). Falls back to a local
# default if unset.
# DATABASE_URL=postgresql+psycopg://postgres:[password]@[host]:5432/postgres
