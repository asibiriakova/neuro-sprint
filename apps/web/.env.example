# Supabase project settings — find these in the Supabase dashboard under
# Project Settings -> API.
#
# Both are safe to expose to the browser (NEXT_PUBLIC_*): Supabase access
# control is enforced by Row Level Security policies on your tables, not
# by keeping the anon key secret.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" API key (Project Settings -> API -> Project API keys).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Setup notes ---------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard.
# 2. Copy the two values above from Project Settings -> API into a new
#    `.env.local` file in this directory (untracked by git).
# 3. For the signup -> immediately-logged-in flow this app implements
#    (see app/signup/actions.ts), disable "Confirm email" under
#    Authentication -> Providers -> Email, since email verification is
#    out of scope for this MVP (tracked separately if ever needed).
